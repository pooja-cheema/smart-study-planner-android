<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03071A">

    <edu.niu.android.smartstudyplanner.ui.SplashBackgroundView
        android:id="@+id/splash_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/glow_outer"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="120dp"
        android:background="@drawable/splash_glow_outer" />

    <View
        android:id="@+id/glow_mid"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="160dp"
        android:background="@drawable/splash_glow_mid" />

    <View
        android:id="@+id/glow_inner"
        android:layout_width="145dp"
        android:layout_height="145dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="198dp"
        android:background="@drawable/splash_glow_inner" />

    <LinearLayout
        android:id="@+id/pill_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pill_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tasks"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pill_goals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goals"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pill_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stats"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pill_cards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🃏"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cards"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pill_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎧"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Music"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/icon_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="210dp"
        android:gravity="center"
        android:background="@drawable/splash_icon_bg">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="56sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/title_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="118dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#03071A"
            android:gravity="center"
            android:background="@drawable/splash_study_badge"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="0dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Planner"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:letterSpacing="-0.02" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">
            <View
                android:layout_width="40dp"
                android:layout_height="1.5dp"
                android:background="#FFD600"
                android:alpha="0.55" />
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/splash_dot"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />
            <View
                android:layout_width="40dp"
                android:layout_height="1.5dp"
                android:background="#FFD600"
                android:alpha="0.55" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STUDY SMARTER · ACHIEVE MORE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#90CAF9"
            android:gravity="center"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dot1"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:background="@drawable/splash_dot"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/dot2"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:background="@drawable/splash_dot"
            android:alpha="0.4"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/dot3"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:background="@drawable/splash_dot"
            android:alpha="0.15" />

    </LinearLayout>

</FrameLayout>