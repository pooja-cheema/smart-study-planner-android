<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/text_course_name_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Course Name"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_credits_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 cr"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_grade_row"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_background"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_points_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.0 pts"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_delete_entry"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#C62828"
            android:contentDescription="Remove course" />

    </LinearLayout>
</androidx.cardview.widget.CardView>